/* ============================================================
   STORAGE — v5 com migração automática de v4
   ============================================================ */
const STORAGE_KEY = 'dashboard-caixa-v5';
const STORAGE_KEY_OLD = 'dashboard-caixa-v4';
const DATA_VERSION = '2026-10-07-v5';

function salvarLocal(){
  try{
    localStorage.setItem(STORAGE_KEY, JSON.stringify({dados: STATE.dados, resumo: STATE.resumo, versao: DATA_VERSION, atualizado: new Date().toISOString()}));
    return true;
  }catch(e){ console.error(e); return false; }
}
function carregarLocal(){
  try{
    // Tenta v5 primeiro
    let raw = localStorage.getItem(STORAGE_KEY);
    if(raw){
      const obj = JSON.parse(raw);
      if(obj && Array.isArray(obj.dados) && obj.dados.length) return obj;
    }
    // Migra de v4 se existir
    raw = localStorage.getItem(STORAGE_KEY_OLD);
    if(raw){
      const obj = JSON.parse(raw);
      if(obj && Array.isArray(obj.dados) && obj.dados.length){
        // Migra para v5
        localStorage.setItem(STORAGE_KEY, raw);
        return obj;
      }
    }
    return null;
  }catch(e){ return null; }
}
function limparLocal(){ localStorage.removeItem(STORAGE_KEY); localStorage.removeItem(STORAGE_KEY_OLD); }

const $ = s => document.querySelector(s);
const $$ = s => Array.from(document.querySelectorAll(s));
const fmtBRL = n => (n||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const fmtBRL0 = n => (n||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL',maximumFractionDigits:0});
const fmtNum = n => (n||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
const fmtK = n => { const a=Math.abs(n); if(a>=1e6) return (n/1e6).toFixed(1).replace('.',',')+'M'; if(a>=1e3) return (n/1e3).toFixed(0)+'k'; return n.toFixed(0); };
const MESES_PT = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
const MESES_FULL = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];

function parseData(s){ s=String(s||'').trim(); let m=s.match(/^(\d{4})-(\d{2})-(\d{2})/); if(m) return `${m[1]}-${m[2]}-${m[3]}`; m=s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})/); if(m) return `${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`; return null; }
function parseValor(s){ if(typeof s==='number') return s; s=String(s||'').replace(/[R$\s]/g,''); if(s.includes(',')) s=s.replace(/\./g,'').replace(',','.'); const n=parseFloat(s); return isNaN(n)?0:n; }
function tipoNorm(s){ const t=String(s||'').trim().toUpperCase(); if(t==='C'||t==='CREDITO'||t==='CRÉDITO'||t==='RECEITA'||t==='ENTRADA') return 'C'; return 'D'; }
function corCategoria(nome){ const f=STATE.resumo.categorias.find(c=>c.nome===nome); if(f) return f.cor; const p=nome.slice(0,2); const m={'01':'#4f8cff','02':'#38bdf8','03':'#f59e0b','04':'#a78bfa','05':'#f472b6','06':'#34d399'}; return m[p]||'#8899bb'; }
function parseExtrato(txt){
  const linhas = String(txt).split(/\r?\n/);
  const out = [];
  for(const linha of linhas){
    const raw = linha.trim();
    if(!raw) continue;
    let sep='|';
    if(!raw.includes('|')){ if(raw.includes('\t')) sep='\t'; else if(raw.includes(';')) sep=';'; else if(raw.includes(',')) sep=','; else continue; }
    const p = raw.split(sep).map(x=>x.trim());
    if(p.length<4) continue;
    const data = parseData(p[0]);
    if(!data) continue;
    if(/^(total|data)/i.test(p[0])) continue;
    out.push({data, categoria: p[1]||'Não classificado', valor: parseValor(p[2]), tipo: tipoNorm(p[3]), detalhe: p[4]||''});
  }
  out.sort((a,b)=>a.data.localeCompare(b.data));
  return out;
}
function toast(msg, tipo='ok'){
  const el = $('#toast');
  el.textContent = msg;
  el.className = 'toast show ' + (tipo==='error'?'error':tipo==='info'?'info':'');
  clearTimeout(el._t);
  el._t = setTimeout(()=>el.classList.remove('show'), 3200);
}

const STATE = { dados:[], resumo:null, saldoInicial:0, mesIni:0, mesFim:9, catGeral:'todas', tipoGeral:'todos', busca:'', origem:'original' };

function getMesesFiltrados(){ const o=[]; for(let i=STATE.mesIni;i<=STATE.mesFim;i++) o.push(i); return o; }
function getCategoriasFiltradas(){ return STATE.resumo.categorias.filter(c=>{ if(STATE.catGeral!=='todas' && c.nome!==STATE.catGeral) return false; return true; }); }
function categoriaPassaFiltro(nome){ return STATE.catGeral==='todas'||nome===STATE.catGeral; }
function tipoPassaFiltro(t){ if(STATE.tipoGeral==='todos') return true; if(STATE.tipoGeral==='receita'&&t==='C') return true; if(STATE.tipoGeral==='despesa'&&t==='D') return true; return false; }
function getTotaisFiltrados(){
  const meses=getMesesFiltrados(), cats=getCategoriasFiltradas();
  let rec=0, desp=0;
  meses.forEach(m=>cats.forEach(c=>{ const v=c.valores[m]||0; if(c.tipo==='Receita'&&(STATE.tipoGeral==='todos'||STATE.tipoGeral==='receita')) rec+=v; if(c.tipo==='Despesa'&&(STATE.tipoGeral==='todos'||STATE.tipoGeral==='despesa')) desp+=v; }));
  return {rec, desp, resultado: rec-desp};
}
function getMovimentosFiltrados(){
  return STATE.dados.filter(d=>{
    const m = parseInt(d.data.slice(5,7),10)-1;
    if(m<STATE.mesIni || m>STATE.mesFim) return false;
    if(STATE.catGeral!=='todas' && d.categoria!==STATE.catGeral) return false;
    if(!tipoPassaFiltro(d.tipo)) return false;
    if(STATE.busca){ const b=`${d.categoria} ${d.detalhe} ${d.data} ${d.valor}`.toLowerCase(); if(!b.includes(STATE.busca.toLowerCase())) return false; }
    return true;
  });
}

const NS='http://www.w3.org/2000/svg';
function svgEl(tag,attrs={}){ const e=document.createElementNS(NS,tag); for(const k in attrs) e.setAttribute(k,attrs[k]); return e; }
function clearSvg(svg){ while(svg.firstChild) svg.removeChild(svg.firstChild); }

function renderChartMensal(){
  const svg=$('#chartMensal'); clearSvg(svg);
  const W=900,H=340,P={t:22,r:20,b:46,l:66};
  const iw=W-P.l-P.r, ih=H-P.t-P.b;
  const meses=getMesesFiltrados(); if(!meses.length) return;
  const cats=getCategoriasFiltradas();
  const rec = meses.map(m=>cats.filter(c=>c.tipo==='Receita'&&(STATE.tipoGeral==='todos'||STATE.tipoGeral==='receita')).reduce((s,c)=>s+(c.valores[m]||0),0));
  const des = meses.map(m=>cats.filter(c=>c.tipo==='Despesa'&&(STATE.tipoGeral==='todos'||STATE.tipoGeral==='despesa')).reduce((s,c)=>s+(c.valores[m]||0),0));
  const res = meses.map((_,i)=>rec[i]-des[i]);
  const maxV = Math.max(1,...rec,...des)*1.12;
  const minR = Math.min(0,...res), maxR = Math.max(1,...res)*1.2;
  const n = meses.length, slot = iw/n, bw = Math.min(26,slot*0.32);
  for(let i=0;i<=5;i++){
    const y = P.t+ih-(ih*i/5);
    svg.appendChild(svgEl('line',{x1:P.l,y1:y,x2:W-P.r,y2:y,stroke:'var(--chart-grid)','stroke-width':1,'stroke-dasharray':i===0?'0':'3 4'}));
    const t=svgEl('text',{x:P.l-10,y:y+4,fill:'var(--chart-text)','font-size':11,'text-anchor':'end'}); t.textContent=fmtK(maxV*i/5); svg.appendChild(t);
  }
  meses.forEach((mi,idx)=>{
    const cx = P.l+slot*idx+slot/2;
    const hR = (rec[idx]/maxV)*ih, hD = (des[idx]/maxV)*ih;
    const b1 = svgEl('rect',{x:cx-bw-3,y:P.t+ih-hR,width:bw,height:Math.max(hR,0),rx:4,fill:'var(--green)',opacity:.92});
    const t1 = svgEl('title'); t1.textContent = `${MESES_FULL[mi]} — Receita: ${fmtBRL(rec[idx])}`; b1.appendChild(t1); svg.appendChild(b1);
    const b2 = svgEl('rect',{x:cx+3,y:P.t+ih-hD,width:bw,height:Math.max(hD,0),rx:4,fill:'var(--red)',opacity:.92});
    const t2 = svgEl('title'); t2.textContent = `${MESES_FULL[mi]} — Despesa: ${fmtBRL(des[idx])}`; b2.appendChild(t2); svg.appendChild(b2);
    const t = svgEl('text',{x:cx,y:H-P.b+22,fill:'var(--chart-text)','font-size':12,'text-anchor':'middle','font-weight':600}); t.textContent=MESES_PT[mi]; svg.appendChild(t);
  });
  const rangeR = (maxR-minR)||1;
  const pts = res.map((v,i)=>{ const cx = P.l+slot*i+slot/2; const cy = P.t+ih-((v-minR)/rangeR)*ih; return {x:cx,y:cy,v}; });
  if(pts.length>1) svg.appendChild(svgEl('polyline',{points:pts.map(p=>`${p.x},${p.y}`).join(' '),fill:'none',stroke:'var(--amber)','stroke-width':2.4,'stroke-linejoin':'round','stroke-linecap':'round'}));
  pts.forEach(p=>{ const c=svgEl('circle',{cx:p.x,cy:p.y,r:4,fill:'var(--amber)',stroke:'var(--surface)','stroke-width':2}); const t=svgEl('title'); t.textContent=`Resultado: ${fmtBRL(p.v)}`; c.appendChild(t); svg.appendChild(c); });
}

function renderBarrasH(targetId,tipo,topN){
  const svg=$(targetId); clearSvg(svg);
  const W=700, meses=getMesesFiltrados();
  const cats = STATE.resumo.categorias.filter(c=>c.tipo===tipo).filter(c=>categoriaPassaFiltro(c.nome));
  const itens = cats.map(c=>{ let s=0; meses.forEach(m=>s+=c.valores[m]||0); return {nome:c.nome,cor:c.cor,val:s}; }).filter(x=>x.val>0).sort((a,b)=>b.val-a.val);
  const lista = topN?itens.slice(0,topN):itens;
  const rowH=40, H=Math.max(120,lista.length*rowH+30);
  svg.setAttribute('viewBox',`0 0 ${W} ${H}`);
  if(!lista.length){ const t=svgEl('text',{x:W/2,y:60,fill:'var(--chart-text)','font-size':13,'text-anchor':'middle'}); t.textContent='Sem dados no período'; svg.appendChild(t); return; }
  const maxV=lista[0].val, labelW=190, barW=W-labelW-110;
  lista.forEach((it,i)=>{
    const y=14+i*rowH, w=Math.max(2,(it.val/maxV)*barW);
    const lb=svgEl('text',{x:0,y:y+18,fill:'var(--chart-text)','font-size':12,'font-weight':600}); lb.textContent=it.nome.length>26?it.nome.slice(0,25)+'…':it.nome; svg.appendChild(lb);
    svg.appendChild(svgEl('rect',{x:labelW,y:y+4,width:barW,height:20,rx:6,fill:'var(--surface-3)'}));
    const bar=svgEl('rect',{x:labelW,y:y+4,width:w,height:20,rx:6,fill:it.cor,opacity:.9});
    const ti=svgEl('title'); ti.textContent=`${it.nome}: ${fmtBRL(it.val)}`; bar.appendChild(ti); svg.appendChild(bar);
    const v=svgEl('text',{x:labelW+barW+10,y:y+19,fill:'var(--text)','font-size':12,'font-weight':700,'text-anchor':'start'}); v.textContent=fmtBRL0(it.val); svg.appendChild(v);
  });
}

function renderSaldo(){
  const svg=$('#chartSaldo'); clearSvg(svg);
  const W=700,H=320,P={t:24,r:24,b:44,l:70};
  const iw=W-P.l-P.r, ih=H-P.t-P.b;
  const movs=getMovimentosFiltrados();
  if(!movs.length){ const t=svgEl('text',{x:W/2,y:H/2,fill:'var(--chart-text)','font-size':13,'text-anchor':'middle'}); t.textContent='Sem movimentações no período'; svg.appendChild(t); return; }
  const porDia = new Map();
  movs.forEach(d=>{ if(!porDia.has(d.data)) porDia.set(d.data,{r:0,d:0}); const o=porDia.get(d.data); if(d.tipo==='C') o.r+=d.valor; else o.d+=d.valor; });
  const dias = Array.from(porDia.keys()).sort();
  let saldo = 0;
  const serie = dias.map(dia=>{ const o=porDia.get(dia); saldo+=o.r-o.d; return {dia,saldo}; });
  const vals = serie.map(s=>s.saldo);
  const min = Math.min(0,...vals), max = Math.max(1,...vals);
  const range = (max-min)||1;
  for(let i=0;i<=4;i++){
    const y = P.t+ih-(ih*i/4);
    svg.appendChild(svgEl('line',{x1:P.l,y1:y,x2:W-P.r,y2:y,stroke:'var(--chart-grid)','stroke-width':1,'stroke-dasharray':i===0?'0':'3 4'}));
    const t=svgEl('text',{x:P.l-10,y:y+4,fill:'var(--chart-text)','font-size':11,'text-anchor':'end'}); t.textContent=fmtK(min+range*i/4); svg.appendChild(t);
  }
  const X=i=>P.l+(serie.length===1?iw/2:(iw*i/(serie.length-1)));
  const Y=v=>P.t+ih-((v-min)/range)*ih;
  const pts = serie.map((s,i)=>`${X(i)},${Y(s.saldo)}`).join(' ');
  const defs = svgEl('defs');
  const lg = svgEl('linearGradient',{id:'gradSaldo',x1:'0',y1:'0',x2:'0',y2:'1'});
  lg.appendChild(svgEl('stop',{offset:'0%','stop-color':'var(--accent)','stop-opacity':.75}));
  lg.appendChild(svgEl('stop',{offset:'100%','stop-color':'var(--accent)','stop-opacity':0}));
  defs.appendChild(lg); svg.appendChild(defs);
  svg.appendChild(svgEl('polygon',{points:`${P.l},${P.t+ih} ${pts} ${X(serie.length-1)},${P.t+ih}`,fill:'url(#gradSaldo)',opacity:.35}));
  svg.appendChild(svgEl('polyline',{points:pts,fill:'none',stroke:'var(--accent)','stroke-width':2.6,'stroke-linejoin':'round','stroke-linecap':'round'}));
  const step = Math.max(1,Math.floor(serie.length/40));
  serie.forEach((s,i)=>{
    if(i%step!==0 && i!==serie.length-1) return;
    const c=svgEl('circle',{cx:X(i),cy:Y(s.saldo),r:3,fill:'var(--accent)',stroke:'var(--surface)','stroke-width':1.5});
    const t=svgEl('title'); t.textContent=`${s.dia.split('-').reverse().join('/')} — Saldo: ${fmtBRL(s.saldo)}`; c.appendChild(t); svg.appendChild(c);
  });
  const nLab = Math.min(6,serie.length);
  for(let i=0;i<nLab;i++){
    const idx = Math.round(i*(serie.length-1)/Math.max(1,nLab-1));
    const t=svgEl('text',{x:X(idx),y:H-P.b+22,fill:'var(--chart-text)','font-size':11,'text-anchor':'middle'});
    const [a,m,d]=serie[idx].dia.split('-'); t.textContent=`${d}/${m}`; svg.appendChild(t);
  }
}

function renderKPIs(){
  const {rec,desp,resultado} = getTotaisFiltrados();
  const nMeses = STATE.mesFim-STATE.mesIni+1;
  const margem = rec>0?(resultado/rec*100):0;
  const movs = getMovimentosFiltrados();
  const volExtrato = movs.reduce((s,d)=>s+d.valor,0);
  const catsDesp = getCategoriasFiltradas().filter(c=>c.tipo==='Despesa'&&(STATE.tipoGeral==='todos'||STATE.tipoGeral==='despesa'));
  const topDesp = catsDesp.map(c=>{ let t=0; getMesesFiltrados().forEach(m=>t+=c.valores[m]||0); return {nome:c.nome,val:t}; }).sort((a,b)=>b.val-a.val)[0];
  const saldoExtrato = movs.reduce((s,d)=>s+(d.tipo==='C'?d.valor:-d.valor),0);
  const cards = [
    {label:'💰 Receita Total',cls:'green',valor:fmtBRL(rec),sub:`${nMeses} ${nMeses===1?'mês':'meses'} · média ${fmtBRL(rec/nMeses)}/mês`},
    {label:'💸 Despesa Total',cls:'red',valor:fmtBRL(desp),sub: topDesp?`maior: ${topDesp.nome} (${fmtBRL0(topDesp.val)})`:`média ${fmtBRL(desp/nMeses)}/mês`},
    {label:'📈 Resultado do Período',cls:resultado>=0?'green':'red',valor:fmtBRL(resultado),sub:`margem de ${margem.toFixed(2)}% sobre a receita`},
    {label:'🧾 Movimentações',cls:'purple',valor:movs.length.toLocaleString('pt-BR'),sub:`volume filtrado de ${fmtBRL(volExtrato)}`},
    {label:'📊 Média Diária de Despesa',cls:'amber',valor:fmtBRL(desp/(nMeses*30)),sub:'estimativa com 30 dias/mês'},
    {label:'🏦 Saldo do Período (extrato)',cls:'green',valor:fmtBRL(saldoExtrato),sub:`base: ${movs.length} lançamentos no extrato`}
  ];
  $('#kpiBox').innerHTML = cards.map(c=>`<div class="card ${c.cls}"><div class="kpi-label">${c.label}</div><div class="kpi-value">${c.valor}</div><div class="kpi-sub">${c.sub}</div></div>`).join('');
}

function renderResumoMensal(){
  const meses = getMesesFiltrados(), cats = getCategoriasFiltradas();
  let html = '<thead><tr><th>Mês</th><th>Receita</th><th>Despesa</th><th>Resultado</th><th>Margem</th></tr></thead><tbody>';
  let tR=0,tD=0;
  meses.forEach(i=>{
    const r = cats.filter(c=>c.tipo==='Receita'&&(STATE.tipoGeral==='todos'||STATE.tipoGeral==='receita')).reduce((s,c)=>s+(c.valores[i]||0),0);
    const d = cats.filter(c=>c.tipo==='Despesa'&&(STATE.tipoGeral==='todos'||STATE.tipoGeral==='despesa')).reduce((s,c)=>s+(c.valores[i]||0),0);
    const res = r-d; tR+=r; tD+=d;
    html += `<tr><td>${MESES_FULL[i]}</td><td class="pos">${fmtNum(r)}</td><td class="neg">${fmtNum(d)}</td><td class="${res>=0?'pos':'neg'}">${fmtNum(res)}</td><td class="muted">${r>0?((res/r)*100).toFixed(1):'0,0'}%</td></tr>`;
  });
  const tRes = tR-tD;
  html += `<tr class="total-row"><td>TOTAL</td><td class="pos">${fmtNum(tR)}</td><td class="neg">${fmtNum(tD)}</td><td class="${tRes>=0?'pos':'neg'}">${fmtNum(tRes)}</td><td>${tR>0?((tRes/tR)*100).toFixed(2):'0,00'}%</td></tr></tbody>`;
  $('#tblResumo').innerHTML = html;
}

function renderMatriz(){
  const meses=getMesesFiltrados(), todasCats=getCategoriasFiltradas();
  const desps = todasCats.filter(c=>c.tipo==='Despesa'), recs = todasCats.filter(c=>c.tipo==='Receita');
  let head = '<thead><tr><th>Categoria</th>';
  meses.forEach(i=> head += `<th>${MESES_PT[i]}</th>`);
  head += '<th>Total</th></tr></thead>';
  const linha = (c)=>{
    let soma=0, cols='';
    meses.forEach(i=>{ const v=c.valores[i]||0; soma+=v; cols += `<td>${v?fmtNum(v):'<span class="muted">—</span>'}</td>`; });
    return `<tr><td><span class="cat-dot" style="background:${c.cor}"></span>${c.nome}</td>${cols}<td style="font-weight:800">${fmtNum(soma)}</td></tr>`;
  };
  let body = '<tbody>';
  if(desps.length){
    body += `<tr class="total-row"><td colspan="${meses.length+2}" style="text-align:left;color:var(--red)">DESPESAS</td></tr>`;
    desps.forEach(c=> body += linha(c));
    const totDesp = meses.map(i=>desps.reduce((s,c)=>s+(c.valores[i]||0),0));
    body += `<tr class="total-row"><td>Total Despesas</td>${totDesp.map(v=>`<td>${fmtNum(v)}</td>`).join('')}<td>${fmtNum(totDesp.reduce((a,b)=>a+b,0))}</td></tr>`;
  }
  if(recs.length){
    body += `<tr class="total-row"><td colspan="${meses.length+2}" style="text-align:left;color:var(--green)">RECEITAS</td></tr>`;
    recs.forEach(c=> body += linha(c));
    const totRec = meses.map(i=>recs.reduce((s,c)=>s+(c.valores[i]||0),0));
    body += `<tr class="total-row"><td>Total Receitas</td>${totRec.map(v=>`<td>${fmtNum(v)}</td>`).join('')}<td>${fmtNum(totRec.reduce((a,b)=>a+b,0))}</td></tr>`;
  }
  body += '</tbody>';
  $('#tblMatriz').innerHTML = head+body;
  $('#matrizSub').textContent = `${desps.length+recs.length} categorias · ${meses.length} meses`;
}

function renderRanking(){
  const meses=getMesesFiltrados(), cats=getCategoriasFiltradas();
  const itens = cats.map(c=>{ let s=0; meses.forEach(m=>s+=c.valores[m]||0); return {...c,total:s}; }).filter(x=>x.total>0).sort((a,b)=>b.total-a.total);
  const totDesp = itens.filter(x=>x.tipo==='Despesa').reduce((a,b)=>a+b.total,0);
  const totRec = itens.filter(x=>x.tipo==='Receita').reduce((a,b)=>a+b.total,0);
  let html = `<thead><tr><th>Categoria</th><th>Tipo</th><th>Total</th><th>% do Tipo</th><th>Média/Mês</th></tr></thead><tbody>`;
  const nMeses = meses.length;
  itens.forEach(c=>{
    const base = c.tipo==='Despesa'?totDesp:totRec;
    const pct = base>0?(c.total/base*100):0;
    html += `<tr><td><span class="cat-dot" style="background:${c.cor}"></span>${c.nome}</td><td><span class="tag ${c.tipo==='Receita'?'C':'D'}">${c.tipo}</span></td><td style="font-weight:700">${fmtNum(c.total)}</td><td>${pct.toFixed(1)}%</td><td class="muted">${fmtNum(c.total/nMeses)}</td></tr>`;
  });
  html += '</tbody>';
  $('#tblCat').innerHTML = html;
}

function renderMov(){
  const filtrado = getMovimentosFiltrados();
  let saldo=0;
  const comSaldo = filtrado.map(d=>{ saldo += (d.tipo==='C'?d.valor:-d.valor); return {...d,saldo}; });
  const totR = filtrado.filter(d=>d.tipo==='C').reduce((s,d)=>s+d.valor,0);
  const totD = filtrado.filter(d=>d.tipo==='D').reduce((s,d)=>s+d.valor,0);
  $('#movInfo').innerHTML = `${filtrado.length} lançamentos · <span class="pos">${fmtBRL(totR)}</span> · <span class="neg">${fmtBRL(totD)}</span> · resultado <strong class="${totR-totD>=0?'pos':'neg'}">${fmtBRL(totR-totD)}</strong>`;
  let html = `<thead><tr><th>Data</th><th>Categoria</th><th>Detalhamento</th><th>Tipo</th><th>Receita</th><th>Despesa</th><th>Saldo</th></tr></thead><tbody>`;
  if(!filtrado.length){ html += `<tr><td colspan="7" style="text-align:center;padding:40px" class="muted">Nenhum lançamento encontrado com os filtros atuais.</td></tr>`; }
  else{
    comSaldo.forEach(d=>{
      const [a,m,dia] = d.data.split('-');
      html += `<tr><td>${dia}/${m}/${a}</td><td><span class="cat-dot" style="background:${corCategoria(d.categoria)}"></span>${d.categoria}</td><td style="text-align:left;max-width:420px;white-space:normal;color:var(--muted);font-weight:400">${d.detalhe||'—'}</td><td><span class="tag ${d.tipo}">${d.tipo==='C'?'Receita':'Despesa'}</span></td><td class="pos">${d.tipo==='C'?fmtNum(d.valor):'—'}</td><td class="neg">${d.tipo==='D'?fmtNum(d.valor):'—'}</td><td style="font-weight:700">${fmtNum(d.saldo)}</td></tr>`;
    });
  }
  html += `<tr class="total-row"><td colspan="4">TOTAL FILTRADO</td><td class="pos">${fmtNum(totR)}</td><td class="neg">${fmtNum(totD)}</td><td class="${totR-totD>=0?'pos':'neg'}">${fmtNum(totR-totD)}</td></tr></tbody>`;
  $('#tblMov').innerHTML = html;
}

/* ============================================================
   COMPARATIVOS
   ============================================================ */
function getMovimentosComparativos(){
  return STATE.dados.filter(d=>{
    const m = parseInt(d.data.slice(5,7),10)-1;
    if(m<STATE.mesIni || m>STATE.mesFim) return false;
    if(STATE.catGeral!=='todas' && d.categoria!==STATE.catGeral) return false;
    if(!tipoPassaFiltro(d.tipo)) return false;
    if(STATE.busca){ const b=`${d.categoria} ${d.detalhe} ${d.data} ${d.valor}`.toLowerCase(); if(!b.includes(STATE.busca.toLowerCase())) return false; }
    return true;
  });
}
function calcQuinzenal(){
  const meses = getMesesFiltrados();
  const movs = getMovimentosComparativos();
  const porMes = new Map();
  meses.forEach(m => porMes.set(m,{q1R:0,q2R:0,q1D:0,q2D:0}));
  movs.forEach(d=>{
    const m = parseInt(d.data.slice(5,7),10)-1;
    const dia = parseInt(d.data.slice(8,10),10);
    const o = porMes.get(m); if(!o) return;
    const isFirst = dia<=15;
    if(d.tipo==='C'){ if(isFirst) o.q1R+=d.valor; else o.q2R+=d.valor; }
    else{ if(isFirst) o.q1D+=d.valor; else o.q2D+=d.valor; }
  });
  return meses.map(m=>{
    const o = porMes.get(m);
    const totalR = o.q1R+o.q2R, totalD = o.q1D+o.q2D;
    const varR = o.q1R>0?((o.q2R-o.q1R)/o.q1R*100):(o.q2R>0?100:0);
    const varD = o.q1D>0?((o.q2D-o.q1D)/o.q1D*100):(o.q2D>0?100:0);
    return {mesIdx:m, mesNome:MESES_FULL[m], mesAbrev:MESES_PT[m], q1R:o.q1R, q2R:o.q2R, q1D:o.q1D, q2D:o.q2D, totalR, totalD, resultado: totalR-totalD, varR, varD};
  }).filter(x=>x.totalR>0 || x.totalD>0);
}
function calcTrimestral(){
  const movs = getMovimentosComparativos();
  const quarters = [
    {label:'Q1 (Jan-Mar)',nome:'1º Trimestre',meses:[0,1,2]},
    {label:'Q2 (Abr-Jun)',nome:'2º Trimestre',meses:[3,4,5]},
    {label:'Q3 (Jul-Set)',nome:'3º Trimestre',meses:[6,7,8]},
    {label:'Q4 (Out-Dez)',nome:'4º Trimestre',meses:[9,10,11]}
  ];
  return quarters.map(q=>{
    let r=0,d=0,n=0;
    movs.forEach(m=>{ const mi=parseInt(m.data.slice(5,7),10)-1; if(!q.meses.includes(mi)) return; if(m.tipo==='C') r+=m.valor; else d+=m.valor; n++; });
    return {...q,receita:r,despesa:d,resultado:r-d,n};
  }).filter(q=>q.receita>0||q.despesa>0);
}
function calcSemestral(){
  const movs = getMovimentosComparativos();
  const semestres = [
    {label:'S1 (Jan-Jun)',nome:'1º Semestre',meses:[0,1,2,3,4,5]},
    {label:'S2 (Jul-Dez)',nome:'2º Semestre',meses:[6,7,8,9,10,11]}
  ];
  return semestres.map(s=>{
    let r=0,d=0,n=0;
    movs.forEach(m=>{ const mi=parseInt(m.data.slice(5,7),10)-1; if(!s.meses.includes(mi)) return; if(m.tipo==='C') r+=m.valor; else d+=m.valor; n++; });
    return {...s,receita:r,despesa:d,resultado:r-d,n};
  }).filter(s=>s.receita>0||s.despesa>0);
}
function renderBarChartGrouped(svgId,labels,series){
  const svg = $(svgId); clearSvg(svg);
  const W=900, H=380, P={t:30,r:20,b:60,l:70};
  const iw=W-P.l-P.r, ih=H-P.t-P.b;
  if(!labels.length){ const t=svgEl('text',{x:W/2,y:H/2,fill:'var(--chart-text)','font-size':14,'text-anchor':'middle'}); t.textContent='Sem dados no período'; svg.appendChild(t); return; }
  const allVals = series.flatMap(s=>s.values);
  const maxV = Math.max(1,...allVals)*1.15;
  for(let i=0;i<=5;i++){
    const y = P.t+ih-(ih*i/5);
    svg.appendChild(svgEl('line',{x1:P.l,y1:y,x2:W-P.r,y2:y,stroke:'var(--chart-grid)','stroke-width':1,'stroke-dasharray':i===0?'0':'3 4'}));
    const t = svgEl('text',{x:P.l-10,y:y+4,fill:'var(--chart-text)','font-size':11,'text-anchor':'end'}); t.textContent=fmtK(maxV*i/5); svg.appendChild(t);
  }
  const n = labels.length, slot = iw/n, nSeries = series.length;
  const totalBarsW = slot*0.7, bw = totalBarsW/nSeries;
  labels.forEach((lbl,idx)=>{
    const cx = P.l+slot*idx+slot/2, startX = cx-totalBarsW/2;
    series.forEach((s,si)=>{
      const v = s.values[idx]||0, h = (v/maxV)*ih, x = startX+si*bw;
      const bar = svgEl('rect',{x:x+2,y:P.t+ih-h,width:bw-4,height:Math.max(h,0),rx:3,fill:s.color,opacity:.92});
      const ti = svgEl('title'); ti.textContent=`${lbl} — ${s.name}: ${fmtBRL(v)}`; bar.appendChild(ti); svg.appendChild(bar);
    });
    const t = svgEl('text',{x:cx,y:H-P.b+22,fill:'var(--chart-text)','font-size':11,'text-anchor':'middle','font-weight':600}); t.textContent=lbl; svg.appendChild(t);
  });
  let lx = P.l; const ly = H-20;
  series.forEach(s=>{
    svg.appendChild(svgEl('rect',{x:lx,y:ly-8,width:11,height:11,rx:3,fill:s.color}));
    const t = svgEl('text',{x:lx+16,y:ly+2,fill:'var(--chart-text)','font-size':11,'font-weight':600}); t.textContent=s.name; svg.appendChild(t);
    lx += 16+s.name.length*7+24;
  });
}
function renderComparativos(){
  // QUINZENAL
  const qz = calcQuinzenal();
  const totQ1R = qz.reduce((s,x)=>s+x.q1R,0);
  const totQ2R = qz.reduce((s,x)=>s+x.q2R,0);
  const totQ1D = qz.reduce((s,x)=>s+x.q1D,0);
  const totQ2D = qz.reduce((s,x)=>s+x.q2D,0);
  const cardsQz = [
    {label:'💰 1ª Quinzena (Receita)',cls:'green',valor:fmtBRL(totQ1R),sub:`${qz.length} meses · dias 1–15`},
    {label:'💰 2ª Quinzena (Receita)',cls:'green',valor:fmtBRL(totQ2R),sub:`variação ${totQ1R>0?((totQ2R-totQ1R)/totQ1R*100).toFixed(1):'0'}% vs 1ª`},
    {label:'💸 1ª Quinzena (Despesa)',cls:'red',valor:fmtBRL(totQ1D),sub:`${qz.length} meses · dias 1–15`},
    {label:'💸 2ª Quinzena (Despesa)',cls:'red',valor:fmtBRL(totQ2D),sub:`variação ${totQ1D>0?((totQ2D-totQ1D)/totQ1D*100).toFixed(1):'0'}% vs 1ª`}
  ];
  $('#kpiQuinzenal').innerHTML = cardsQz.map(c=>`<div class="card ${c.cls}"><div class="kpi-label">${c.label}</div><div class="kpi-value">${c.valor}</div><div class="kpi-sub">${c.sub}</div></div>`).join('');
  renderBarChartGrouped('#chartQuinzenal', qz.map(x=>x.mesAbrev), [
    {name:'1ª Q Receita',color:'#2ecc8f',values:qz.map(x=>x.q1R)},
    {name:'2ª Q Receita',color:'#10b981',values:qz.map(x=>x.q2R)},
    {name:'1ª Q Despesa',color:'#ff5f6d',values:qz.map(x=>x.q1D)},
    {name:'2ª Q Despesa',color:'#e11d48',values:qz.map(x=>x.q2D)}
  ]);
  let htmlQz = `<thead><tr><th>Mês</th><th>1ª Q Receita</th><th>2ª Q Receita</th><th>Var %</th><th>1ª Q Despesa</th><th>2ª Q Despesa</th><th>Var %</th><th>Resultado</th></tr></thead><tbody>`;
  qz.forEach(x=>{
    const clsR = x.varR>0?'trend-up':x.varR<0?'trend-down':'muted';
    const clsD = x.varD>0?'trend-up':x.varD<0?'trend-down':'muted';
    htmlQz += `<tr><td>${x.mesNome}</td><td class="pos">${fmtNum(x.q1R)}</td><td class="pos">${fmtNum(x.q2R)}</td><td class="${clsR}">${(x.varR>0?'+':'')}${x.varR.toFixed(1)}%</td><td class="neg">${fmtNum(x.q1D)}</td><td class="neg">${fmtNum(x.q2D)}</td><td class="${clsD}">${(x.varD>0?'+':'')}${x.varD.toFixed(1)}%</td><td class="${x.resultado>=0?'pos':'neg'}" style="font-weight:800">${fmtNum(x.resultado)}</td></tr>`;
  });
  const totQz = totQ1R+totQ2R-totQ1D-totQ2D;
  htmlQz += `<tr class="total-row"><td>TOTAL</td><td class="pos">${fmtNum(totQ1R)}</td><td class="pos">${fmtNum(totQ2R)}</td><td>${totQ1R>0?((totQ2R-totQ1R)/totQ1R*100).toFixed(1):'0'}%</td><td class="neg">${fmtNum(totQ1D)}</td><td class="neg">${fmtNum(totQ2D)}</td><td>${totQ1D>0?((totQ2D-totQ1D)/totQ1D*100).toFixed(1):'0'}%</td><td class="${totQz>=0?'pos':'neg'}">${fmtNum(totQz)}</td></tr></tbody>`;
  $('#tblQuinzenal').innerHTML = htmlQz;
  $('#quinzSub').textContent = `${qz.length} meses · 1ª quinzena (dias 1–15) × 2ª quinzena (dias 16–31)`;

  // TRIMESTRAL
  const tr = calcTrimestral();
  let bestTr=null, worstTr=null;
  tr.forEach(x=>{ if(!bestTr||x.resultado>bestTr.resultado) bestTr=x; if(!worstTr||x.resultado<worstTr.resultado) worstTr=x; });
  const totTrR = tr.reduce((s,x)=>s+x.receita,0);
  const totTrD = tr.reduce((s,x)=>s+x.despesa,0);
  const cardsTr = [
    {label:'💰 Receita Total',cls:'green',valor:fmtBRL(totTrR),sub:`${tr.length} trimestres`},
    {label:'💸 Despesa Total',cls:'red',valor:fmtBRL(totTrD),sub:`${tr.length} trimestres`},
    {label:'📈 Melhor Trimestre',cls:'green',valor: bestTr?bestTr.label:'—',sub: bestTr?fmtBRL(bestTr.resultado):'—'},
    {label:'📉 Pior Trimestre',cls:'red',valor: worstTr?worstTr.label:'—',sub: worstTr?fmtBRL(worstTr.resultado):'—'}
  ];
  $('#kpiTrimestral').innerHTML = cardsTr.map(c=>`<div class="card ${c.cls}"><div class="kpi-label">${c.label}</div><div class="kpi-value">${c.valor}</div><div class="kpi-sub">${c.sub}</div></div>`).join('');
  renderBarChartGrouped('#chartTrimestral', tr.map(x=>x.label), [
    {name:'Receita',color:'#2ecc8f',values:tr.map(x=>x.receita)},
    {name:'Despesa',color:'#ff5f6d',values:tr.map(x=>x.despesa)}
  ]);
  let htmlTr = `<thead><tr><th>Trimestre</th><th>Receita</th><th>Despesa</th><th>Resultado</th><th>Margem</th><th>Variação</th></tr></thead><tbody>`;
  tr.forEach((x,i)=>{
    const margem = x.receita>0?(x.resultado/x.receita*100):0;
    let variacao='—', clsVar='muted';
    if(i>0){ const prev = tr[i-1].resultado; if(prev!==0){ const v = ((x.resultado-prev)/Math.abs(prev))*100; variacao = (v>0?'+':'')+v.toFixed(1)+'%'; clsVar = v>0?'trend-up':v<0?'trend-down':'muted'; } }
    htmlTr += `<tr><td>${x.nome} <span class="muted small">${x.label.split(' ')[1]}</span></td><td class="pos">${fmtNum(x.receita)}</td><td class="neg">${fmtNum(x.despesa)}</td><td class="${x.resultado>=0?'pos':'neg'}" style="font-weight:800">${fmtNum(x.resultado)}</td><td class="muted">${margem.toFixed(1)}%</td><td class="${clsVar}">${variacao}</td></tr>`;
  });
  htmlTr += `<tr class="total-row"><td>TOTAL</td><td class="pos">${fmtNum(totTrR)}</td><td class="neg">${fmtNum(totTrD)}</td><td class="${totTrR-totTrD>=0?'pos':'neg'}">${fmtNum(totTrR-totTrD)}</td><td>${totTrR>0?((totTrR-totTrD)/totTrR*100).toFixed(2):'0,00'}%</td><td>—</td></tr></tbody>`;
  $('#tblTrimestral').innerHTML = htmlTr;

  // SEMESTRAL
  const sm = calcSemestral();
  let bestSm=null, worstSm=null;
  sm.forEach(x=>{ if(!bestSm||x.resultado>bestSm.resultado) bestSm=x; if(!worstSm||x.resultado<worstSm.resultado) worstSm=x; });
  const totSmR = sm.reduce((s,x)=>s+x.receita,0);
  const totSmD = sm.reduce((s,x)=>s+x.despesa,0);
  const cardsSm = [
    {label:'💰 Receita Total',cls:'green',valor:fmtBRL(totSmR),sub:`${sm.length} semestres`},
    {label:'💸 Despesa Total',cls:'red',valor:fmtBRL(totSmD),sub:`${sm.length} semestres`},
    {label:'📈 Melhor Semestre',cls:'green',valor: bestSm?bestSm.label:'—',sub: bestSm?fmtBRL(bestSm.resultado):'—'},
    {label:'📉 Pior Semestre',cls:'red',valor: worstSm?worstSm.label:'—',sub: worstSm?fmtBRL(worstSm.resultado):'—'}
  ];
  $('#kpiSemestral').innerHTML = cardsSm.map(c=>`<div class="card ${c.cls}"><div class="kpi-label">${c.label}</div><div class="kpi-value">${c.valor}</div><div class="kpi-sub">${c.sub}</div></div>`).join('');
  renderBarChartGrouped('#chartSemestral', sm.map(x=>x.label), [
    {name:'Receita',color:'#2ecc8f',values:sm.map(x=>x.receita)},
    {name:'Despesa',color:'#ff5f6d',values:sm.map(x=>x.despesa)}
  ]);
  let htmlSm = `<thead><tr><th>Semestre</th><th>Receita</th><th>Despesa</th><th>Resultado</th><th>Margem</th><th>Variação</th></tr></thead><tbody>`;
  sm.forEach((x,i)=>{
    const margem = x.receita>0?(x.resultado/x.receita*100):0;
    let variacao='—', clsVar='muted';
    if(i>0){ const prev = sm[i-1].resultado; if(prev!==0){ const v = ((x.resultado-prev)/Math.abs(prev))*100; variacao = (v>0?'+':'')+v.toFixed(1)+'%'; clsVar = v>0?'trend-up':v<0?'trend-down':'muted'; } }
    htmlSm += `<tr><td>${x.nome} <span class="muted small">${x.label.split(' ')[1]}</span></td><td class="pos">${fmtNum(x.receita)}</td><td class="neg">${fmtNum(x.despesa)}</td><td class="${x.resultado>=0?'pos':'neg'}" style="font-weight:800">${fmtNum(x.resultado)}</td><td class="muted">${margem.toFixed(1)}%</td><td class="${clsVar}">${variacao}</td></tr>`;
  });
  htmlSm += `<tr class="total-row"><td>TOTAL</td><td class="pos">${fmtNum(totSmR)}</td><td class="neg">${fmtNum(totSmD)}</td><td class="${totSmR-totSmD>=0?'pos':'neg'}">${fmtNum(totSmR-totSmD)}</td><td>${totSmR>0?((totSmR-totSmD)/totSmR*100).toFixed(2):'0,00'}%</td><td>—</td></tr></tbody>`;
  $('#tblSemestral').innerHTML = htmlSm;
}

function renderStats(){
  const d = STATE.dados;
  if(!d.length){ $('#statsBox').innerHTML='<p class="muted small">Sem dados.</p>'; return; }
  const datas = d.map(x=>x.data).sort();
  const cats = new Set(d.map(x=>x.categoria));
  const rec = d.filter(x=>x.tipo==='C').reduce((s,x)=>s+x.valor,0);
  const des = d.filter(x=>x.tipo==='D').reduce((s,x)=>s+x.valor,0);
  const linhas = [
    ['Período', `${datas[0].split('-').reverse().join('/')} → ${datas[datas.length-1].split('-').reverse().join('/')}`],
    ['Lançamentos', d.length.toLocaleString('pt-BR')],
    ['Categorias distintas', cats.size],
    ['Total de receitas', fmtBRL(rec)],
    ['Total de despesas', fmtBRL(des)],
    ['Resultado do extrato', fmtBRL(rec-des)],
    ['Maior lançamento', fmtBRL(Math.max(...d.map(x=>x.valor)))],
    ['Menor lançamento', fmtBRL(Math.min(...d.map(x=>x.valor)))]
  ];
  $('#statsBox').innerHTML = linhas.map(([k,v])=>`<div style="display:flex;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px solid var(--border)"><span class="muted small">${k}</span><strong class="small">${v}</strong></div>`).join('');
}
function renderStorage(){
  const tamanho = (()=>{ try{ const raw = localStorage.getItem(STORAGE_KEY); return raw?(raw.length/1024).toFixed(1)+' KB':'—'; }catch(e){ return '—'; } })();
  const linhas = [
    ['Origem dos dados', STATE.origem==='local'?'💾 Salvos no navegador':'📦 Dados originais do arquivo'],
    ['Versão do dataset', DATA_VERSION],
    ['Categorias no resumo', STATE.resumo.categorias.length],
    ['Lançamentos no extrato', STATE.dados.length.toLocaleString('pt-BR')],
    ['Espaço usado', tamanho],
    ['Limite do navegador', '≈ 5 MB']
  ];
  $('#storageBox').innerHTML = linhas.map(([k,v])=>`<div style="display:flex;justify-content:space-between;gap:14px;padding:10px 0;border-bottom:1px solid var(--border)"><span class="muted small">${k}</span><strong class="small">${v}</strong></div>`).join('');
}
function atualizarStatusSave(){
  const el = $('#saveStatus');
  if(STATE.origem==='local'){ el.className='save-status saved'; el.textContent='💾 Salvo no navegador'; }
  else{ el.className='save-status'; el.textContent='📦 Dados originais'; }
}
function mesesComDados(){
  const set = new Set();
  STATE.resumo.categorias.forEach(c=>{ c.valores.forEach((v,i)=>{ if(v>0) set.add(i); }); });
  return Array.from(set).sort((a,b)=>a-b);
}
function popularSelects(){
  const meses = mesesComDados();
  if(!meses.length){ $('#fMesIni').innerHTML='<option>—</option>'; $('#fMesFim').innerHTML='<option>—</option>'; return; }
  const opts = meses.map(i=>`<option value="${i}">${MESES_FULL[i]}</option>`).join('');
  $('#fMesIni').innerHTML = opts; $('#fMesFim').innerHTML = opts;
  const ini = meses.includes(STATE.mesIni)?STATE.mesIni:meses[0];
  const fim = meses.includes(STATE.mesFim)?STATE.mesFim:meses[meses.length-1];
  STATE.mesIni = ini; STATE.mesFim = fim;
  $('#fMesIni').value = ini; $('#fMesFim').value = fim;
  const cats = STATE.resumo.categorias.map(c=>`<option value="${c.nome}">${c.nome}</option>`).join('');
  const catAtual = STATE.catGeral;
  $('#fCat').innerHTML = `<option value="todas">Todas</option>${cats}`;
  if(STATE.resumo.categorias.some(c=>c.nome===catAtual)) $('#fCat').value = catAtual;
  else{ $('#fCat').value = 'todas'; STATE.catGeral = 'todas'; }
}
function atualizarBadge(){
  const badge = $('#filterBadge');
  const partes = [];
  const ultimoMes = mesesComDados().slice(-1)[0];
  if(STATE.mesIni!==0 || STATE.mesFim!==ultimoMes){ partes.push(`<strong>${MESES_PT[STATE.mesIni]}–${MESES_PT[STATE.mesFim]}</strong>`); }
  if(STATE.catGeral!=='todas') partes.push(`<strong>${STATE.catGeral}</strong>`);
  if(STATE.tipoGeral!=='todos') partes.push(`<strong>${STATE.tipoGeral}</strong>`);
  if(STATE.busca) partes.push(`"<strong>${STATE.busca}</strong>"`);
  if(partes.length){ badge.style.display='inline-flex'; badge.innerHTML = `Filtros ativos: ${partes.join(' · ')}`; }
  else{ badge.style.display='none'; }
}
function renderAll(){
  renderKPIs(); renderChartMensal();
  renderBarrasH('#chartCat','Despesa',6);
  renderBarrasH('#chartCatFull','Despesa',null);
  renderBarrasH('#chartRecFull','Receita',null);
  renderSaldo(); renderResumoMensal(); renderMatriz(); renderRanking();
  renderMov(); renderComparativos(); renderStats(); renderStorage();
  atualizarStatusSave(); atualizarBadge();
  $('#topCatSub').textContent = `${MESES_PT[STATE.mesIni]} — ${MESES_PT[STATE.mesFim]}`;
  $('#saldoSub').textContent = `${MESES_PT[STATE.mesIni]} — ${MESES_PT[STATE.mesFim]}`;
  $('#brandSub').textContent = `${MESES_PT[STATE.mesIni]} a ${MESES_PT[STATE.mesFim]} · ${STATE.dados.length} lançamentos · ${STATE.resumo.categorias.length} categorias`;
}

/* ============================================================
   EXCEL
   ============================================================ */
function parseExtratoSheet(wb){
  const names = wb.SheetNames;
  const prefer = ['Controle de Caixa Unificado','EXTRATO BASE','Extrato Base','Extrato'];
  let sheetName = prefer.find(n=>names.includes(n));
  if(!sheetName) sheetName = names.find(n=>/controle.*caixa|extrato/i.test(n));
  if(!sheetName) return null;
  const sheet = wb.Sheets[sheetName];
  const data = XLSX.utils.sheet_to_json(sheet,{header:1,raw:true,defval:null});
  const out = [];
  for(let i=0;i<data.length;i++){
    const row = data[i];
    if(!row || row.length<4) continue;
    const c0 = row[0]; if(c0==null) continue;
    let dataISO = null;
    if(c0 instanceof Date){ const y=c0.getUTCFullYear(), m=String(c0.getUTCMonth()+1).padStart(2,'0'), d=String(c0.getUTCDate()).padStart(2,'0'); dataISO=`${y}-${m}-${d}`; }
    else{ dataISO = parseData(String(c0)); }
    if(!dataISO) continue;
    if(/^(total|data)/i.test(String(c0))) continue;
    const col1 = String(row[1]||'').trim();
    const col3 = String(row[3]||'').trim();
    const isUnificado = /^(receita|despesa)$/i.test(col1);
    let categoria, valor, tipo, detalhe;
    if(isUnificado){
      tipo = tipoNorm(col1);
      categoria = String(row[2]||'').trim();
      detalhe = String(row[3]||'').trim();
      const recVal = parseValor(row[4]), despVal = parseValor(row[5]);
      valor = tipo==='C'?recVal:despVal;
      if(!valor) continue;
    }else{
      categoria = col1;
      valor = parseValor(row[2]);
      if(valor===0) continue;
      tipo = tipoNorm(col3);
      detalhe = String(row[4]||'').trim();
    }
    if(!categoria) continue;
    out.push({data: dataISO, categoria, valor, tipo, detalhe});
  }
  out.sort((a,b)=>a.data.localeCompare(b.data));
  return out;
}
function parseRelatorioSheet(wb){
  const names = wb.SheetNames;
  let sheetName = names.find(n=>/relat[óo]rio/i.test(n));
  if(!sheetName) return null;
  const sheet = wb.Sheets[sheetName];
  const data = XLSX.utils.sheet_to_json(sheet,{header:1,raw:true,defval:null});
  const monthShort = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  let monthRow = -1, monthCols = [];
  for(let i=0;i<data.length;i++){
    const row = data[i]; if(!row) continue;
    const found = []; const seen = new Set();
    for(let c=0;c<row.length;c++){
      const v = String(row[c]||'').toLowerCase().trim();
      if(!v) continue;
      const idx = monthShort.indexOf(v.slice(0,3));
      if(idx>=0 && !seen.has(idx)){ found.push({m:idx,col:c}); seen.add(idx); }
    }
    if(found.length>=3){ monthRow=i; monthCols=found.sort((a,b)=>a.col-b.col); break; }
  }
  if(monthRow<0 || monthCols.length<3) return null;
  const map = new Map();
  for(let r=monthRow+1;r<data.length;r++){
    const row = data[r]; if(!row) continue;
    const nome = String(row[0]||'').trim();
    if(!nome) continue;
    if(/^(total|r[óo]tulos|soma)/i.test(nome)) continue;
    const receitas = new Array(12).fill(0), despesas = new Array(12).fill(0);
    let temDados = false;
    monthCols.forEach(({m,col})=>{
      const recVal = parseValor(row[col]), despVal = parseValor(row[col+1]);
      if(recVal>0){ receitas[m]=recVal; temDados=true; }
      if(despVal>0){ despesas[m]=despVal; temDados=true; }
    });
    if(!temDados) continue;
    if(!map.has(nome)) map.set(nome,{receitas:new Array(12).fill(0),despesas:new Array(12).fill(0)});
    const entry = map.get(nome);
    for(let i=0;i<12;i++){
      if(receitas[i]>0) entry.receitas[i]=receitas[i];
      if(despesas[i]>0) entry.despesas[i]=despesas[i];
    }
  }
  if(!map.size) return null;
  const cores = ['#4f8cff','#38bdf8','#f59e0b','#a78bfa','#f472b6','#34d399','#2ecc8f','#22d3ee','#fbbf24','#818cf8','#10b981','#f87171'];
  let corIdx = 0;
  const categorias = [];
  map.forEach((entry,nome)=>{
    const temRec = entry.receitas.some(v=>v>0), temDesp = entry.despesas.some(v=>v>0);
    const tipo = temRec && !temDesp ? 'Receita' : 'Despesa';
    const valores = tipo==='Receita' ? entry.receitas : entry.despesas;
    const orig = RESUMO_ORIGINAL.categorias.find(c=>c.nome===nome);
    const cor = orig ? orig.cor : cores[corIdx++ % cores.length];
    categorias.push({nome,tipo,cor,valores});
  });
  const receita = new Array(12).fill(0), despesa = new Array(12).fill(0);
  categorias.forEach(c=>{ c.valores.forEach((v,i)=>{ if(c.tipo==='Receita') receita[i]+=v; else despesa[i]+=v; }); });
  return {meses:[...MESES_PT],mesesFull:[...MESES_FULL],receita,despesa,categorias};
}
async function importarArquivoExcel(file){
  if(typeof XLSX==='undefined'){ toast('Biblioteca Excel não disponível. Conecte-se à internet uma vez.','error'); return; }
  try{
    const buf = await file.arrayBuffer();
    const wb = XLSX.read(buf,{type:'array',cellDates:true});
    const movs = parseExtratoSheet(wb);
    if(!movs || !movs.length){ toast('Não foi possível ler a aba de movimentações do arquivo','error'); return; }
    const rel = parseRelatorioSheet(wb);
    STATE.dados = movs;
    STATE.resumo = rel || parseResumoFallback();
    STATE.origem = 'local';
    const meses = mesesComDados();
    if(meses.length){ STATE.mesIni = meses[0]; STATE.mesFim = meses[meses.length-1]; }
    $('#txtDados').value = movs.map(d=>`${d.data}|${d.categoria}|${d.valor}|${d.tipo}|${d.detalhe}`).join('\n');
    $('#txtInfo').textContent = `${movs.length} lançamentos`;
    $('#excelInfo').innerHTML = `<div class="note" style="margin-top:12px"><strong>✓ Arquivo importado:</strong> ${file.name}<br><strong>Lançamentos:</strong> ${movs.length.toLocaleString('pt-BR')}<br><strong>Período:</strong> ${movs[0].data.split('-').reverse().join('/')} → ${movs[movs.length-1].data.split('-').reverse().join('/')}<br><strong>Resumo:</strong> ${rel?'✅ Lido do Relatório':'⚠️ Usando dados originais'}</div>`;
    if(salvarLocal()){ popularSelects(); renderAll(); toast(`✓ ${movs.length} lançamentos importados`); }
    else{ popularSelects(); renderAll(); toast(`✓ ${movs.length} lançamentos (falha ao salvar)`,'error'); }
  }catch(e){ console.error(e); toast('Erro: '+e.message,'error'); }
}
function parseResumoFallback(){ return JSON.parse(JSON.stringify(RESUMO_ORIGINAL)); }

/* ============================================================
   EVENTOS
   ============================================================ */
$$('.tab').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    $$('.tab').forEach(b=>b.classList.remove('active'));
    $$('.panel').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active');
    $('#panel-'+btn.dataset.tab).classList.add('active');
  });
});
$$('.sub-tab').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    $$('.sub-tab').forEach(b=>b.classList.remove('active'));
    $$('.sub-panel').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active');
    $('#sub-'+btn.dataset.sub).classList.add('active');
  });
});
$('#fMesIni').addEventListener('change', e=>{ STATE.mesIni = +e.target.value; if(STATE.mesFim<STATE.mesIni){ STATE.mesFim=STATE.mesIni; $('#fMesFim').value=STATE.mesIni; } renderAll(); });
$('#fMesFim').addEventListener('change', e=>{ STATE.mesFim = +e.target.value; if(STATE.mesIni>STATE.mesFim){ STATE.mesIni=STATE.mesFim; $('#fMesIni').value=STATE.mesFim; } renderAll(); });
$('#fCat').addEventListener('change', e=>{ STATE.catGeral = e.target.value; renderAll(); });
$('#fTipo').addEventListener('change', e=>{ STATE.tipoGeral = e.target.value; renderAll(); });
$('#fBusca').addEventListener('input', e=>{ STATE.busca = e.target.value; renderAll(); });
$('#btnReset').addEventListener('click', ()=>{
  const meses = mesesComDados();
  STATE.mesIni = meses[0] ?? 0;
  STATE.mesFim = meses[meses.length-1] ?? 11;
  STATE.catGeral = 'todas'; STATE.tipoGeral = 'todos'; STATE.busca = '';
  $('#fMesIni').value = STATE.mesIni; $('#fMesFim').value = STATE.mesFim;
  $('#fCat').value = 'todas'; $('#fTipo').value = 'todos'; $('#fBusca').value = '';
  renderAll();
});
$('#btnTheme').addEventListener('click', ()=>{
  const html = document.documentElement;
  const novo = html.dataset.theme === 'dark' ? 'light' : 'dark';
  html.dataset.theme = novo;
  $('#btnTheme').textContent = novo === 'dark' ? '🌙' : '☀️';
  setTimeout(renderAll,60);
});
$('#btnPrint').addEventListener('click', ()=>window.print());
$('#btnExport').addEventListener('click', ()=>{
  const linhas = ['DATA;CATEGORIA;VALOR;TIPO;DETALHAMENTO'];
  STATE.dados.forEach(d=>{ linhas.push([d.data,d.categoria,d.valor.toFixed(2).replace('.',','),d.tipo,(d.detalhe||'').replace(/;/g,',')].join(';')); });
  const blob = new Blob(['\uFEFF'+linhas.join('\n')],{type:'text/csv;charset=utf-8;'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `extrato_base_${new Date().toISOString().slice(0,10)}.csv`;
  a.click(); URL.revokeObjectURL(a.href);
  toast('CSV exportado');
});
$('#btnExcelTop').addEventListener('click', ()=>$('#fileExcel').click());
$('#fileExcel').addEventListener('change', e=>{ const file = e.target.files[0]; if(!file) return; importarArquivoExcel(file); setTimeout(()=>e.target.value='',500); });
const dropzone = $('#dropExcel');
['dragenter','dragover'].forEach(ev=>{ dropzone.addEventListener(ev,e=>{ e.preventDefault(); dropzone.classList.add('dragover'); }); });
['dragleave','drop'].forEach(ev=>{ dropzone.addEventListener(ev,e=>{ e.preventDefault(); dropzone.classList.remove('dragover'); }); });
dropzone.addEventListener('drop', e=>{ const file = e.dataTransfer.files[0]; if(file) importarArquivoExcel(file); });
const overlay = $('#dragOverlay');
let dragCounter = 0;
window.addEventListener('dragenter', e=>{ e.preventDefault(); dragCounter++; if(e.dataTransfer.types.includes('Files')) overlay.classList.add('active'); });
window.addEventListener('dragover', e=>e.preventDefault());
window.addEventListener('dragleave', ()=>{ dragCounter--; if(dragCounter<=0){ dragCounter=0; overlay.classList.remove('active'); } });
window.addEventListener('drop', e=>{ e.preventDefault(); dragCounter=0; overlay.classList.remove('active'); const file = e.dataTransfer.files[0]; if(file) importarArquivoExcel(file); });
$('#btnAplicar').addEventListener('click', ()=>{
  const novos = parseExtrato($('#txtDados').value);
  if(!novos.length){ toast('Nenhum lançamento válido.','error'); return; }
  STATE.dados = novos; STATE.origem = 'local';
  const meses = mesesComDados();
  if(meses.length){ STATE.mesIni = meses[0]; STATE.mesFim = meses[meses.length-1]; }
  salvarLocal(); popularSelects(); renderAll();
  toast(`✓ ${novos.length} lançamentos aplicados`);
});
$('#btnRestaurar').addEventListener('click', ()=>{
  if(!confirm('Restaurar os dados originais do arquivo?')) return;
  limparLocal();
  STATE.dados = parseExtrato(EXTRATO_RAW);
  STATE.resumo = parseResumoFallback();
  STATE.origem = 'original';
  $('#txtDados').value = EXTRATO_RAW.trim();
  popularSelects(); renderAll();
  toast('Dados originais restaurados');
});
$('#btnLimpar').addEventListener('click', ()=>{
  if(!confirm('Apagar tudo que foi salvo no navegador?')) return;
  limparLocal();
  STATE.dados = parseExtrato(EXTRATO_RAW);
  STATE.resumo = parseResumoFallback();
  STATE.origem = 'original';
  $('#txtDados').value = EXTRATO_RAW.trim();
  popularSelects(); renderAll();
  toast('Dados salvos removidos','info');
});

/* ============================================================
   INIT
   ============================================================ */
(function init(){
  const salvo = carregarLocal();
  if(salvo){
    STATE.dados = salvo.dados;
    STATE.resumo = salvo.resumo || parseResumoFallback();
    STATE.origem = 'local';
    $('#txtDados').value = salvo.dados.map(d=>`${d.data}|${d.categoria}|${d.valor}|${d.tipo}|${d.detalhe}`).join('\n');
    $('#txtInfo').textContent = `${salvo.dados.length} lançamentos`;
    setTimeout(()=>toast(`💾 ${salvo.dados.length} lançamentos restaurados`,'info'),500);
  }else{
    STATE.dados = parseExtrato(EXTRATO_RAW);
    STATE.resumo = parseResumoFallback();
    STATE.origem = 'original';
    $('#txtDados').value = EXTRATO_RAW.trim();
    $('#txtInfo').textContent = `${STATE.dados.length} lançamentos`;
  }
  popularSelects();
  renderAll();
})();
</script>
</body>
</html>
