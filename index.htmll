<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dashboard Financeiro — Controle de Caixa</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<style>
:root{--bg:#0b1220;--surface:#111a2e;--surface-2:#16213a;--surface-3:#1c2942;--border:#22304d;--text:#e8eefc;--muted:#8fa1c7;--accent:#4f8cff;--green:#2ecc8f;--red:#ff5f6d;--amber:#ffb347;--purple:#a78bfa;--radius:16px;--radius-sm:10px;--gap:16px;--font:'Inter','Segoe UI',system-ui,sans-serif;--shadow:0 10px 30px rgba(0,0,0,.35);--chart-grid:#22304d;--chart-text:#8fa1c7}
[data-theme="light"]{--bg:#f4f6fb;--surface:#fff;--surface-2:#f0f3fa;--surface-3:#e6ebf5;--border:#dde3ef;--text:#131c2e;--muted:#5f708c;--accent:#2563eb;--green:#0ea672;--red:#e11d48;--amber:#d97706;--purple:#7c3aed;--shadow:0 8px 24px rgba(20,35,70,.1);--chart-grid:#e3e8f2;--chart-text:#6b7b96}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{background:var(--bg);color:var(--text);font-family:var(--font);font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased;transition:background .25s,color .25s}
::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--border);border-radius:20px}::-webkit-scrollbar-thumb:hover{background:var(--muted)}
.app{max-width:1500px;margin:0 auto;padding:22px}
.topbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px}
.brand{display:flex;align-items:center;gap:12px;margin-right:auto}
.brand .logo{width:44px;height:44px;border-radius:13px;background:linear-gradient(135deg,var(--accent),var(--purple));display:grid;place-items:center;font-size:20px;box-shadow:0 6px 18px rgba(79,140,255,.35)}
.brand h1{font-size:18px;font-weight:700;letter-spacing:-.3px}
.brand p{font-size:12px;color:var(--muted)}
.save-status{display:inline-flex;align-items:center;gap:7px;font-size:11.5px;font-weight:600;padding:6px 12px;border-radius:20px;background:var(--surface);border:1px solid var(--border);color:var(--muted)}
.save-status.saved{border-color:var(--green);color:var(--green);background:rgba(46,204,143,.1)}
.btn{display:inline-flex;align-items:center;gap:7px;background:var(--surface);border:1px solid var(--border);color:var(--text);font-family:inherit;font-size:13px;font-weight:500;padding:9px 15px;border-radius:var(--radius-sm);cursor:pointer;transition:.18s;white-space:nowrap}
.btn:hover{background:var(--surface-3);border-color:var(--accent);transform:translateY(-1px)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
.btn.primary:hover{filter:brightness(1.1)}
.btn.excel{background:linear-gradient(135deg,#1d7044,#0ea672);border-color:#0ea672;color:#fff}
.btn.excel:hover{filter:brightness(1.08);border-color:#0ea672}
.btn.ghost{background:transparent}
.btn.danger{border-color:var(--red);color:var(--red)}
.btn.danger:hover{background:rgba(255,95,109,.12)}
.tabs{display:flex;gap:4px;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:5px;margin-bottom:14px;overflow-x:auto}
.tab{flex:1;min-width:130px;background:transparent;border:0;color:var(--muted);font-family:inherit;font-size:13px;font-weight:600;padding:11px 16px;border-radius:10px;cursor:pointer;transition:.18s;white-space:nowrap}
.tab:hover{color:var(--text);background:var(--surface-2)}
.tab.active{background:var(--accent);color:#fff;box-shadow:0 4px 14px rgba(79,140,255,.35)}
.global-filters{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 16px;margin-bottom:18px;position:relative}
.global-filters::before{content:'Filtros globais';position:absolute;top:-9px;left:16px;background:var(--bg);padding:0 8px;font-size:10px;font-weight:800;letter-spacing:.7px;text-transform:uppercase;color:var(--accent)}
.field{display:flex;flex-direction:column;gap:5px}
.field label{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
.field select,.field input{background:var(--surface-2);border:1px solid var(--border);color:var(--text);font-family:inherit;font-size:13px;padding:8px 11px;border-radius:var(--radius-sm);outline:none;transition:.15s;min-width:150px}
.field select:focus,.field input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(79,140,255,.15)}
.field input[type=search]{min-width:260px}
.filter-badge{display:inline-flex;align-items:center;gap:6px;background:var(--surface-3);border-radius:20px;font-size:11px;font-weight:600;padding:4px 10px;color:var(--muted)}
.filter-badge strong{color:var(--accent)}
.panel{display:none;animation:fade .25s ease}
.panel.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.grid{display:grid;gap:var(--gap)}
.kpis{grid-template-columns:repeat(auto-fit,minmax(210px,1fr));margin-bottom:var(--gap)}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px;box-shadow:var(--shadow);position:relative;overflow:hidden}
.card::before{content:'';position:absolute;inset:0 auto 0 0;width:3px;background:var(--accent);opacity:.9}
.card.green::before{background:var(--green)}
.card.red::before{background:var(--red)}
.card.amber::before{background:var(--amber)}
.card.purple::before{background:var(--purple)}
.kpi-label{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.7px;margin-bottom:8px;display:flex;align-items:center;gap:6px}
.kpi-value{font-size:25px;font-weight:800;letter-spacing:-.8px;font-variant-numeric:tabular-nums}
.kpi-sub{font-size:12px;color:var(--muted);margin-top:6px}
.pos{color:var(--green)}.neg{color:var(--red)}
.card-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px;flex-wrap:wrap}
.card-head h3{font-size:14px;font-weight:700;letter-spacing:-.2px}
.card-head span{font-size:12px;color:var(--muted)}
.charts-row{grid-template-columns:3fr 2fr;margin-bottom:var(--gap)}
@media(max-width:1050px){.charts-row{grid-template-columns:1fr}}
.table-wrap{overflow-x:auto;border-radius:var(--radius-sm);max-height:640px;overflow-y:auto}
table{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums}
thead th{position:sticky;top:0;z-index:2;background:var(--surface-2);color:var(--muted);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;text-align:right;padding:11px 12px;border-bottom:1px solid var(--border);white-space:nowrap}
thead th:first-child{text-align:left;left:0;z-index:3}
tbody td{padding:9px 12px;border-bottom:1px solid var(--border);text-align:right;white-space:nowrap}
tbody td:first-child{text-align:left;position:sticky;left:0;background:var(--surface);z-index:1;font-weight:600}
tbody tr:hover td{background:var(--surface-2)}
tbody tr:hover td:first-child{background:var(--surface-2)}
tbody tr.total-row td{font-weight:800;background:var(--surface-3);border-top:2px solid var(--border)}
tbody tr.total-row td:first-child{background:var(--surface-3)}
.tag{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:700}
.tag.C{background:rgba(46,204,143,.14);color:var(--green)}
.tag.D{background:rgba(255,95,109,.14);color:var(--red)}
.cat-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:7px;vertical-align:middle}
.muted{color:var(--muted)}
.small{font-size:12px}
textarea{width:100%;min-height:220px;resize:vertical;background:var(--surface-2);border:1px solid var(--border);color:var(--text);font-family:'SF Mono',Consolas,monospace;font-size:12px;line-height:1.6;padding:14px;border-radius:var(--radius-sm);outline:none}
textarea:focus{border-color:var(--accent)}
.note{background:var(--surface-2);border-left:3px solid var(--accent);border-radius:8px;padding:12px 15px;font-size:12.5px;color:var(--muted);line-height:1.7;margin-bottom:16px}
.note strong{color:var(--text)}
.note code{background:var(--surface-3);padding:1px 6px;border-radius:5px;font-family:'SF Mono',Consolas,monospace;font-size:11.5px;color:var(--amber)}
.dropzone{border:2px dashed var(--border);border-radius:var(--radius);padding:40px 20px;text-align:center;background:var(--surface-2);cursor:pointer;transition:.2s;position:relative}
.dropzone:hover,.dropzone.dragover{border-color:var(--green);background:rgba(46,204,143,.06)}
.dropzone .icon{font-size:44px;margin-bottom:12px}
.dropzone h4{font-size:15px;font-weight:700;margin-bottom:6px}
.dropzone p{font-size:12.5px;color:var(--muted)}
.dropzone input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer}
svg text{font-family:var(--font)}
.badge{font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;background:var(--surface-3);color:var(--muted)}
.toast{position:fixed;bottom:24px;right:24px;z-index:9999;background:var(--surface);border:1px solid var(--border);border-left:4px solid var(--green);padding:13px 18px;border-radius:12px;box-shadow:var(--shadow);font-size:13px;font-weight:600;color:var(--text);opacity:0;transform:translateY(20px);pointer-events:none;transition:.3s;max-width:380px}
.toast.show{opacity:1;transform:translateY(0)}
.toast.error{border-left-color:var(--red)}
.toast.info{border-left-color:var(--accent)}
.drag-overlay{position:fixed;inset:0;z-index:9998;background:rgba(11,18,32,.85);backdrop-filter:blur(6px);display:none;place-items:center;border:3px dashed var(--green)}
.drag-overlay.active{display:grid}
.drag-overlay .msg{text-align:center;font-size:22px;font-weight:800;color:var(--green)}
.drag-overlay .msg .big{font-size:60px;display:block;margin-bottom:20px}
.sub-tabs{display:flex;gap:4px;background:var(--surface-2);border:1px solid var(--border);border-radius:12px;padding:4px;margin-bottom:var(--gap);overflow-x:auto}
.sub-tab{flex:1;min-width:120px;background:transparent;border:0;color:var(--muted);font-family:inherit;font-size:13px;font-weight:600;padding:9px 14px;border-radius:8px;cursor:pointer;transition:.18s;white-space:nowrap}
.sub-tab:hover{color:var(--text);background:var(--surface-3)}
.sub-tab.active{background:var(--surface);color:var(--accent);box-shadow:0 2px 8px rgba(0,0,0,.15)}
.sub-panel{display:none}
.sub-panel.active{display:block;animation:fade .2s ease}
.trend-up{color:var(--red)}.trend-down{color:var(--green)}
</style>
</head>
<body>
<div class="app">

<header class="topbar">
<div class="brand"><div class="logo">💰</div><div><h1>Controle de Caixa</h1><p id="brandSub">Dashboard financeiro consolidado</p></div></div>
<span class="save-status" id="saveStatus">Dados originais</span>
<button class="btn excel" id="btnExcelTop">📊 Atualizar do Excel</button>
<button class="btn ghost" id="btnTheme">🌙</button>
<button class="btn" id="btnPrint">🖨️</button>
<button class="btn primary" id="btnExport">⬇️ CSV</button>
</header>

<nav class="tabs">
<button class="tab active" data-tab="geral">📊 Visão Geral</button>
<button class="tab" data-tab="mensal">📅 Mensal</button>
<button class="tab" data-tab="categorias">🏷️ Categorias</button>
<button class="tab" data-tab="mov">📋 Movimentações</button>
<button class="tab" data-tab="comparativos">📊 Comparativos</button>
<button class="tab" data-tab="dados">⚙️ Dados</button>
</nav>

<div class="global-filters">
<div class="field"><label>Mês inicial</label><select id="fMesIni"></select></div>
<div class="field"><label>Mês final</label><select id="fMesFim"></select></div>
<div class="field"><label>Categoria</label><select id="fCat"><option value="todas">Todas</option></select></div>
<div class="field"><label>Tipo</label><select id="fTipo"><option value="todos">Todos</option><option value="receita">Somente Receitas</option><option value="despesa">Somente Despesas</option></select></div>
<div class="field"><label>Buscar (movimentações)</label><input type="search" id="fBusca" placeholder="Descrição, detalhe, valor..."></div>
<button class="btn ghost" id="btnReset" style="margin-left:auto">↺ Limpar filtros</button>
<div id="filterBadge" class="filter-badge" style="display:none"></div>
</div>

<section class="panel active" id="panel-geral">
<div class="grid kpis" id="kpiBox"></div>
<div class="card" style="margin-bottom:var(--gap)">
<div class="card-head"><h3>Receitas × Despesas por mês</h3><span>Barras: valores mensais · Linha: resultado</span></div>
<svg id="chartMensal" viewBox="0 0 900 340" style="width:100%;height:auto"></svg>
<div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:14px">
<div style="display:flex;align-items:center;gap:7px;font-size:12px;color:var(--muted)"><i style="width:11px;height:11px;border-radius:4px;background:var(--green);display:block"></i>Receita</div>
<div style="display:flex;align-items:center;gap:7px;font-size:12px;color:var(--muted)"><i style="width:11px;height:11px;border-radius:4px;background:var(--red);display:block"></i>Despesa</div>
<div style="display:flex;align-items:center;gap:7px;font-size:12px;color:var(--muted)"><i style="width:11px;height:11px;border-radius:50%;background:var(--amber);display:block"></i>Resultado</div>
</div>
</div>
<div class="grid charts-row">
<div class="card"><div class="card-head"><h3>Top Despesas por Categoria</h3><span id="topCatSub"></span></div><svg id="chartCat" viewBox="0 0 700 320" style="width:100%;height:auto"></svg></div>
<div class="card"><div class="card-head"><h3>Saldo Acumulado</h3><span id="saldoSub"></span></div><svg id="chartSaldo" viewBox="0 0 700 320" style="width:100%;height:auto"></svg></div>
</div>
<div class="card" style="margin-top:var(--gap)">
<div class="card-head"><h3>Resumo Mensal Consolidado</h3><span>Período filtrado</span></div>
<div class="table-wrap"><table id="tblResumo"></table></div>
</div>
</section>

<section class="panel" id="panel-mensal">
<div class="note"><strong>Matriz Categoria × Mês.</strong> Reflete os filtros globais aplicados no topo.</div>
<div class="card">
<div class="card-head"><h3>Detalhamento Mensal por Categoria</h3><span id="matrizSub"></span></div>
<div class="table-wrap"><table id="tblMatriz"></table></div>
</div>
</section>

<section class="panel" id="panel-categorias">
<div class="grid charts-row" style="margin-bottom:var(--gap)">
<div class="card"><div class="card-head"><h3>Despesas por Categoria</h3></div><svg id="chartCatFull" viewBox="0 0 700 340" style="width:100%;height:auto"></svg></div>
<div class="card"><div class="card-head"><h3>Receitas por Categoria</h3></div><svg id="chartRecFull" viewBox="0 0 700 340" style="width:100%;height:auto"></svg></div>
</div>
<div class="card"><div class="card-head"><h3>Ranking de Categorias</h3></div><div class="table-wrap"><table id="tblCat"></table></div></div>
</section>

<section class="panel" id="panel-mov">
<div class="card">
<div class="card-head"><h3>Histórico de Movimentação</h3><span id="movInfo"></span></div>
<div class="table-wrap"><table id="tblMov"></table></div>
</div>
</section>

<section class="panel" id="panel-comparativos">
<div class="note"><strong>📊 Demonstrativos Comparativos.</strong> Compare o desempenho entre quinzenas, trimestres e semestres. Reflete os filtros globais aplicados no topo.</div>

<div class="sub-tabs">
<button class="sub-tab active" data-sub="quinzenal">📅 Quinzenal</button>
<button class="sub-tab" data-sub="trimestral">📆 Trimestral</button>
<button class="sub-tab" data-sub="semestral">🗓️ Semestral</button>
</div>

<div class="sub-panel active" id="sub-quinzenal">
<div class="grid kpis" id="kpiQuinzenal" style="margin-bottom:var(--gap)"></div>
<div class="card" style="margin-bottom:var(--gap)">
<div class="card-head"><h3>Receitas e Despesas: 1ª × 2ª Quinzena</h3><span>Barras agrupadas por quinzena em cada mês</span></div>
<svg id="chartQuinzenal" viewBox="0 0 900 380" style="width:100%;height:auto"></svg>
</div>
<div class="card"><div class="card-head"><h3>Detalhamento Quinzenal por Mês</h3><span id="quinzSub"></span></div><div class="table-wrap"><table id="tblQuinzenal"></table></div></div>
</div>

<div class="sub-panel" id="sub-trimestral">
<div class="grid kpis" id="kpiTrimestral" style="margin-bottom:var(--gap)"></div>
<div class="card" style="margin-bottom:var(--gap)">
<div class="card-head"><h3>Comparativo Trimestral</h3><span>Receita × Despesa por trimestre</span></div>
<svg id="chartTrimestral" viewBox="0 0 900 380" style="width:100%;height:auto"></svg>
</div>
<div class="card"><div class="card-head"><h3>Detalhamento Trimestral</h3></div><div class="table-wrap"><table id="tblTrimestral"></table></div></div>
</div>

<div class="sub-panel" id="sub-semestral">
<div class="grid kpis" id="kpiSemestral" style="margin-bottom:var(--gap)"></div>
<div class="card" style="margin-bottom:var(--gap)">
<div class="card-head"><h3>Comparativo Semestral</h3><span>Receita × Despesa por semestre</span></div>
<svg id="chartSemestral" viewBox="0 0 900 380" style="width:100%;height:auto"></svg>
</div>
<div class="card"><div class="card-head"><h3>Detalhamento Semestral</h3></div><div class="table-wrap"><table id="tblSemestral"></table></div></div>
</div>
</section>

<section class="panel" id="panel-dados">
<div class="note"><strong>🔄 Atualização em um clique:</strong> clique em <em>"Atualizar do Excel"</em> no topo, ou arraste o <code>.xlsx</code> para qualquer lugar da página.</div>
<div class="grid" style="grid-template-columns:1fr 1fr;gap:var(--gap);margin-bottom:var(--gap)">
<div class="card"><div class="card-head"><h3>📊 Importar planilha Excel</h3></div><div class="dropzone" id="dropExcel"><input type="file" id="fileExcel" accept=".xlsx,.xls,.csv"><div class="icon">📄</div><h4>Arraste o arquivo .xlsx aqui</h4><p>ou clique para escolher</p></div><div id="excelInfo" style="margin-top:14px"></div></div>
<div class="card"><div class="card-head"><h3>📦 Informações de armazenamento</h3></div><div id="storageBox"></div></div>
</div>
<div class="card" style="margin-bottom:var(--gap)">
<div class="card-head"><h3>📋 Colar dados manualmente</h3></div>
<textarea id="txtDados" spellcheck="false"></textarea>
<div style="display:flex;gap:10px;margin-top:12px;flex-wrap:wrap">
<button class="btn primary" id="btnAplicar">✓ Aplicar e salvar</button>
<button class="btn" id="btnRestaurar">↺ Restaurar original</button>
<button class="btn danger" id="btnLimpar">🗑️ Limpar tudo</button>
<span class="badge" id="txtInfo"></span>
</div>
</div>
<div class="card"><div class="card-head"><h3>📈 Estatísticas do dataset</h3></div><div id="statsBox"></div></div>
</section>

</div>
<div class="toast" id="toast"></div>
<div class="drag-overlay" id="dragOverlay"><div class="msg"><span class="big">📊</span>Solte o arquivo Excel aqui</div></div>

<script>
/* ============================================================
   BASE DE DADOS EMBUTIDA
   Esta base é usada apenas no primeiro acesso. Depois o navegador
   salva no localStorage automaticamente.
   ============================================================ */
const EXTRATO_RAW = `
2026-01-08|Transferência recebida NE|45000|C|08/01 18:38 NORDESTE COMERCIO E INDUSTRIA DE BEBIDAS
2026-01-08|01 SALÁRIO / ENCARGOS|44814.46|D|SALÁRIO
2026-02-06|Transferência recebida NE|110000|C|06/02 NORDESTE COMERCIO E INDUSTRIA DE BEBIDAS
2026-02-06|01 SALÁRIO / ENCARGOS|60992.54|D|SALÁRIO
2026-03-20|Transferência recebida NE|105000|C|20/03 NORDESTE COMERCIO E INDUSTRIA DE BEBIDAS
2026-03-20|01 SALÁRIO / ENCARGOS|53341|D|SALÁRIO
2026-04-20|Transferência recebida NE|120000|C|20/04 NORDESTE COMERCIO E INDUSTRIA DE BEBIDAS
2026-04-20|01 SALÁRIO / ENCARGOS|45257|D|SALÁRIO
2026-05-20|Transferência recebida NE|100000|C|20/05 NORDESTE COMERCIO E INDUSTRIA DE BEBIDAS
2026-05-20|01 SALÁRIO / ENCARGOS|47463|D|SALÁRIO
2026-06-19|Transferência recebida NE|52000|C|19/06 NORDESTE COMERCIO E INDUSTRIA DE BEBIDAS
2026-06-19|01 SALÁRIO / ENCARGOS|49079|D|SALÁRIO
2026-07-20|Transferência recebida NE|95000|C|20/07 NORDESTE COMERCIO E INDUSTRIA DE BEBIDAS
2026-07-20|01 SALÁRIO / ENCARGOS|42081|D|SALÁRIO
2026-08-20|Transferência recebida NE|48175.65|C|20/08 NORDESTE COMERCIO E INDUSTRIA DE BEBIDAS
2026-08-20|01 SALÁRIO / ENCARGOS|42385|D|SALÁRIO
2026-09-18|Transferência recebida NE|43000|C|18/09 NORDESTE COMERCIO E INDUSTRIA DE BEBIDAS
2026-09-18|01 SALÁRIO / ENCARGOS|43019|D|SALÁRIO
2026-10-02|Transferência recebida NE|42000|C|02/10 NORDESTE COMERCIO E INDUSTRIA DE BEBIDAS
2026-10-02|01 SALÁRIO / ENCARGOS|42033.5|D|FLASH APP - VA E VT OUTUBRO
`;

const RESUMO_ORIGINAL = {
  mesesFull:['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'],
